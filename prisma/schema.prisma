generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 訂單：免會員結帳，一張訂單可同時含一次性品項與訂閱品項
model Order {
  id                 String         @id // AVL + timestamp36 + random，亦作為綠界 MerchantTradeNo 前綴
  email              String
  name               String
  phone              String
  company            String?
  taxId              String? // 統編
  note               String?
  locale             String         @default("zh-TW")
  items              String // JSON: [{ sku, qty }]
  oneTimeTotal       Int            @default(0) // 一次性小計（未稅，TWD）
  monthlyTotal       Int            @default(0) // 月費小計（未稅，TWD/月）
  status             String         @default("pending") // pending | paid | partial | failed | cancelled
  // 契約同意的留證：客戶結帳時同意的條款版本、內容雜湊、時間與來源 IP。
  // 條款會隨部署改版，沒有這四個欄位就無法證明客戶當初同意的是什麼。
  // 雜湊由伺服器以自己的條款內容計算（見 lib/legal-consent.ts），不接受前端傳值。
  agreedTermsVersion String?
  agreedTermsHash    String?
  agreedAt           DateTime?
  agreedIp           String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  payments           Payment[]
  subscriptions      Subscription[]
}

// 一次綠界交易（一次性付款一筆；定期定額授權一筆）
model Payment {
  id              Int       @id @default(autoincrement())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id])
  merchantTradeNo String    @unique // 送綠界的交易編號
  kind            String // onetime | period
  amount          Int // 含稅總額（TWD）
  // pending | paid | failed | cancelled（換方案／重新授權後作廢的舊授權，不計入訂單狀態）
  status          String    @default("pending")
  ecpayTradeNo    String?
  paymentType     String? // Credit_CreditCard / ATM_xxx / CVS_xxx
  paidAt          DateTime?
  rawReturn       String? // 綠界回傳原始參數 JSON
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// 月費訂閱（綠界信用卡定期定額授權）
model Subscription {
  id                Int       @id @default(autoincrement())
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id])
  merchantTradeNo   String    @unique
  sku               String
  monthlyAmount     Int // 含稅每期扣款額（TWD）
  // pending | active | failed | cancelled | replaced（換方案或重新授權後的舊訂閱）
  status            String    @default("pending")
  startsAt          DateTime? // 訂單成立時間（＝結帳當下），僅供排序與陳年訂單判定
  // 網站上線驗收日。含建置的訂單，月費一律等到這一天才開始——月費買的是主機、備份、
  // 監控與改稿，網站沒上線時這些服務都還沒發生，先收就是收了沒有對價的錢。
  // 站方於後台按「標記已上線」時寫入，同時才寄出定期定額授權連結、才起算承諾期。
  // 單購維護（無建置）不經過這個欄位：既有網站當下就在提供服務，結帳當下即授權。
  launchedAt        DateTime?
  authLinkSentAt    DateTime? // 最近一次寄出授權連結給客戶的時間
  remindersSent     Int       @default(0) // 已寄出的授權/續約提醒次數（上限 2）
  totalSuccessTimes Int       @default(0)
  lastChargeAt      DateTime?
  gwsr              String? // 綠界授權單號，後台停扣用
  cancelledAt       DateTime? // 終止扣款的時間（後台或客戶自助）
  cancelResult      String? // 綠界終止 API 回傳原始內容
  rawReturn         String?
  // 追完提醒仍未授權時，通知站方人工處理的時間（只通知一次）
  escalatedAt       DateTime?
  // ── 欠費催收 ──
  // 綠界定期定額扣款失敗不會自動重試，該期就是沒收到；下一期仍照排程扣。
  // 所以「欠費」的實際樣態是連續數期 failed，而不是一次性的終止事件——
  // 沒有這兩個欄位就只剩「寄一封信然後不了了之」，合約的 24 個月形同不可執行。
  pastDueSince      DateTime? // 第一次扣款失敗的時間；任一期扣款成功即清空
  dunningStage      Int       @default(0) // 已送出的催收階段：0 未催 / 1=D+3 / 2=D+7 / 3=D+15 暫停 / 4=D+30 終止
  // 促銷方案的最短承諾期。一般月費方案為 null＝無綁約。
  // 換方案／重新授權時會沿用到新訂閱，承諾期不因換方案重新起算。
  termMonths        Int?
  commitEndsAt      DateTime?
  // 綠界定期定額無法改金額或換卡，換方案／重新授權一律是「終止舊的、開新的」。
  // 這裡記錄新訂閱是從哪一筆換過來的，才追得回同一個客戶的訂閱史。
  previousMtn       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// 聯絡 / 客製需求詢問單。同時承載客戶站（多租戶）的表單提交。
model Inquiry {
  id        Int       @id @default(autoincrement())
  // 客戶站 slug（見 src/lib/tenants.ts）。null = Avalo 主站自己的詢問單。
  // 刻意存字串而非 FK：租戶登錄表住在程式碼裡，沒有 Tenant table。
  // 必須 nullable —— SQLite 的 ALTER TABLE ADD COLUMN 只有加 nullable 欄位時
  // 才是 metadata-only 操作，加 NOT NULL 會整表重建。
  tenantId  String?
  name      String
  email     String
  phone     String?
  company   String?
  service   String? // 表單名稱（例：線上估價單）
  budget    String?
  message   String // 人類可讀全文
  payload   String? // JSON：結構化欄位，各家表單形狀不同就靠這個
  locale    String    @default("zh-TW")
  handled   Boolean   @default(false)
  handledAt DateTime?
  notified  Boolean   @default(false) // 通知信是否真的寄出（sendMail 回傳值）
  createdAt DateTime  @default(now())

  // 服務 portal 的「本租戶依時間倒序」列表與 CSV 匯出。
  // handled 不另建索引：單租戶幾百到幾千列，SQLite 全掃比走索引還快。
  @@index([tenantId, createdAt])
}

// 客戶站的「今日供應」看板。目前只有 Monsieur Long 用（Tenant.flavorBoard）。
//
// 為什麼口味目錄留在程式碼、只有「今天賣哪幾款」進資料庫：
// 口味的插畫、風味描述、色票幾個月才動一次，屬於設計資產，適合走版控與部署；
// 但「今天出哪幾桶」每天都變，不可能每天重新部署。兩者分開，各自用對的工具。
// 一個租戶一列（覆寫式），不留每日歷史——店家要的是「現在牆上寫什麼」。
model FlavorBoard {
  tenantId  String   @id // 見 src/lib/tenants.ts 的 slug，非 FK
  slugs     String   @default("[]") // JSON 陣列：口味目錄裡的 slug
  extras    String   @default("[]") // JSON 陣列：目錄還沒收錄的臨時口味名稱
  note      String? // 一句公告，例：今日提早售完
  updatedAt DateTime @updatedAt
}

// 客戶站的線上訂單（目前只有 REKAT ROASTERY 用，見 Tenant.shop）。
//
// 為什麼不共用上面的 Order：那一張是 Avalo 自己的方案訂購單，綁著綠界金流、
// 訂閱、條款留證，欄位形狀完全不同。客戶站的商店是「豆子 × 研磨度 × 數量」加上
// 匯款／貨到付款兩種線下收款——硬塞進同一張表只會讓兩邊都長出用不到的欄位。
//
// 金額一律以「下單當下」的數字入庫（unitPrice / subtotal / total）。
// 豆單改價之後，舊訂單還要能對得起帳，不能回頭去讀 _data/beans.ts 重算。
model ShopOrder {
  id       String @id // 人可讀的訂單編號：RK + yymmdd + 4 碼（見 lib/order-id.ts）
  tenantId String // 見 src/lib/tenants.ts 的 slug，非 FK

  name    String
  phone   String
  email   String?
  address String
  note    String?

  // JSON: [{ slug, name, unitPrice, qty, amount }]
  // amount = qty × unitPrice，不含優惠。本店只出原豆，沒有研磨度這個欄位。
  items String
  // JSON: [{ slug, name, label, per, sets, unitPrice, bundlePrice, saved }]
  // 三包優惠的折抵明細。分開存而不攤回 items 的理由：老闆對帳時要看得出
  // 「品項小計」與「實收」中間那一段差額是怎麼來的，攤進單價就查不回去了。
  bundles String @default("[]")

  payment     String // transfer 匯款 | cod 貨到付款
  subtotal    Int // 品項小計（已扣掉三包優惠）
  shippingFee Int
  total       Int

  // pending 待確認 | confirmed 已確認 | shipped 已出貨 | done 已完成 | cancelled 取消
  status String @default("pending")

  // 付款回報：客人自己填的帳號／交易末五碼與時間（匯款與 LINE Pay 都用這組欄位）。
  // 店家核帳後把 status 推進 confirmed。
  remitLast5 String?
  remitName  String?
  remitAt    DateTime?

  notified  Boolean  @default(false) // 通知信是否真的寄出
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt])
}

// 客戶站的「本期供應狀態」。目前只有 REKAT ROASTERY 用（Tenant.shop）。
//
// 為什麼豆單目錄留在程式碼、只有「現在賣不賣」進資料庫（同 FlavorBoard 的取捨）：
// 品名、售價、風味家族、插畫母題、產區背景與文案，一季才動一次，屬於設計與編輯資產，
// 適合走版控與部署；但「這支賣完了」隨時會發生，不可能為它重新部署一次。
//
// 更關鍵的是價格：priceCart() 是前後台共用的同步純函式，客人的瀏覽器要能自己算出
// 同一個金額，這才讓「前端偽造價格無效」在結構上成立。把售價搬進資料庫會讓這條路
// 變成非同步，等於拆掉那個保證。所以資料庫只承載「狀態」，不承載「身分與價格」。
//
// 一個租戶一列（覆寫式），不留歷史——店家要的是「現在櫃上有什麼」。
model BeanStock {
  tenantId  String   @id // 見 src/lib/tenants.ts 的 slug，非 FK
  soldOut   String   @default("[]") // JSON 陣列：標為售完的 slug（仍列出，但不能下單）
  hidden    String   @default("[]") // JSON 陣列：暫時下架的 slug（前台完全不出現）
  note      String? // 一句公告，例：本週出貨順延
  updatedAt DateTime @updatedAt
}
