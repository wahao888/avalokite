# Avalo — fail2ban 設定（放到 /etc/fail2ban/jail.local）
#
# 網頁層的三個 jail 只封 http/https 埠，不封 22：
# 這是刻意的，萬一自己人誤觸也不會連 SSH 都進不來，救得回來。

[sshd]
enabled = true
maxretry = 4
bantime = 1h
findtime = 10m

# nginx 限流被觸發（error.log 出現 limiting requests）→ 封鎖
# maxretry 從 10 放寬到 30：Next.js 的 _rsc 預抓是一次一整批，正常使用者
# 開幾個頁面就可能連續觸發十幾次限流，10 次會誤封真人（2026-07-30 差點封到 Barry 自己）。
# 真正的掃描器有 avalo-scan 那個 jail 負責，這個 jail 只擋持續性的洗版。
[nginx-limit-req]
enabled  = true
filter   = nginx-limit-req
logpath  = /var/log/nginx/error.log
action   = iptables-multiport[name=nginx-limit-req, port="http,https"]
maxretry = 30
findtime = 5m
bantime  = 1h

# 已知的漏洞掃描路徑（wp-admin、phpmyadmin 之類）
[nginx-botsearch]
enabled  = true
filter   = nginx-botsearch
logpath  = /var/log/nginx/access.log
action   = iptables-multiport[name=nginx-botsearch, port="http,https"]
maxretry = 5
findtime = 10m
bantime  = 6h

# 自訂：後台／客戶後台登入失敗（見 filter.d/avalo-auth.conf）。
# 讀 systemd journal，因為登入成功與失敗在 nginx log 裡都是 303、分不出來。
# 密碼本身極難破解（後台 20 字元約 119 bits、客戶後台 12 字元約 71 bits），
# 這個 jail 的價值主要在「偵測與可見度」——讓有人在試這件事被記錄下來。
[avalo-auth]
enabled  = true
filter   = avalo-auth
backend  = systemd
action   = iptables-multiport[name=avalo-auth, port="http,https"]
maxretry = 5
findtime = 10m
bantime  = 1h

# 自訂：一擊即封——探測 .env / wp-admin / .git 之類路徑（見 filter.d/avalo-honeypath.conf）。
# 這類請求只有攻擊者會發，所以 maxretry=1，不必等累積。
# 2026-07-31 簡報顯示 409 次 .env 探測分散在 50 個 IP，每個都剛好打不到
# avalo-scan 的 40 次門檻就換 IP——這個 jail 就是補那個縫。
[avalo-honeypath]
enabled  = true
filter   = avalo-honeypath
logpath  = /var/log/nginx/access.log
action   = iptables-multiport[name=avalo-honeypath, port="http,https"]
maxretry = 1
findtime = 1d
bantime  = 1d

# 自訂：短時間內大量 4xx＝掃描器或灌水機器人（見 filter.d/avalo-scan.conf）
# maxretry 抓 40 是為了不誤傷正常使用者（一般人不會 5 分鐘內產生 40 個 4xx）
[avalo-scan]
enabled  = true
filter   = avalo-scan
logpath  = /var/log/nginx/access.log
action   = iptables-multiport[name=avalo-scan, port="http,https"]
maxretry = 40
findtime = 5m
bantime  = 6h
