  },
  {
   "start": 7.579,
   "end": 8.948,
   "text": "*阿瓦羅*來了"
  },
  {
   "start": 10.639,
   "end": 12.787,
   "text": "先蓋一個讓人一眼就信任的"
  },
  {
   "start": 12.727,
   "end": 13.95,
   "text": "*品牌官網*"
  },
  {
   "start": 15.996,
   "end": 18.035,
   "text": "裝上*購物車和金流*"
  },
  {
   "start": 17.975,
   "end": 19.501,
   "text": "訂單自己進來"
  },
  {
   "start": 21.454,
   "end": 23.296,
   "text": "半夜有人問？"
  },
  {
   "start": 23.236,
   "end": 24.789,
   "text": "*AI 客服*在 LINE 上"
  },
  {
   "start": 24.729,
