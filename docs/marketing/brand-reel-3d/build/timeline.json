   "text": "馬上回"
  },
  {
   "start": 27.782,
   "end": 30.609,
   "text": "報表、通知、重複的流程"
  },
  {
   "start": 30.549,
   "end": 32.306,
   "text": "交給*自動化*去跑"
  },
  {
   "start": 34.211,
   "end": 35.8,
   "text": "讓 Google *找得到你*"
  },
  {
   "start": 35.74,
   "end": 37.436,
   "text": "也讓 AI *讀得懂你*"
  },
  {
   "start": 39.568,
   "end": 40.878,
   "text": "上線之後"
  },
  {
   "start": 40.818,
   "end": 42.939,
   "text": "*全年*都有人替你顧著"
  },
  {
   "start": 45.025,
